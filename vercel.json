{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile && pnpm --filter api prisma generate && pnpm --filter api build",
      "entrypoint": "src/vercel.ts"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)",     "destination": { "service": "web" } }
  ]
}
