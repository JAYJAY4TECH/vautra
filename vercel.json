{
  "version": 2,
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter api prisma generate && pnpm --filter api build && pnpm --filter web build",
  "framework": null,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/api/src/vercel.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/src/vercel.ts" },
    { "src": "/(.*)",     "dest": "apps/web/$1" }
  ],
  "functions": {
    "apps/api/src/vercel.ts": {
      "maxDuration": 10,
      "includeFiles": "apps/api/node_modules/.prisma/**"
    }
  }
}
